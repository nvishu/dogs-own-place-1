# Copy this file to .env.local for local dev. On Vercel add the same names under
# Project → Settings → Environment Variables. NEVER commit real values.

# MongoDB Atlas connection string (URL-encode special chars in the password: @ → %40, $ → %24)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dogs-own-place?retryWrites=true&w=majority

# Random string, 32+ chars. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin login (no DB record). Use a long unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "false" in production once real payments (Razorpay) are integrated
ALLOW_MOCK_PAYMENTS=true

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Business details shown on the site (all optional; defaults live in src/lib/site.js) ──
NEXT_PUBLIC_PHONE=+91 98765 43210
NEXT_PUBLIC_EMAIL=hello@dogsownplace.com
# WhatsApp button appears only when set. Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP=

# ── Email alerts for new contact-form messages (optional, via resend.com) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
